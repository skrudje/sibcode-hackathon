# Public template for local development. These are not production credentials.
# Copy to .env; keep real passwords and CONNECTOR_SECRET_* values only in .env.
POSTGRES_PASSWORD=hryukers-local-db
DEMO_EMAIL=marketer@example.com
DEMO_PASSWORD=HryukersDemo2026!
WEB_PORT=5180
DATABASE_URL=postgresql+psycopg://hryukers:hryukers-local-db@localhost:55432/hryukers
REDIS_URL=redis://localhost:56379/0
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
UPLOAD_DIR=.data/uploads
DEMO_DIR=.data/demo
MOCK_SOURCE_URL=http://localhost:8011/events
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=HryukersAdmin2026!
SEED_WORKSPACE_DATA=true
# Add real tenant API hostnames here; HTTP is reserved for explicitly trusted local sources.
CONNECTOR_ALLOWED_HOSTS=mock-source,localhost,127.0.0.1
CONNECTOR_HTTP_HOSTS=mock-source,localhost,127.0.0.1
