# Public template for the isolated hryukers-e2e test project.
# Copy to .env.e2e; never run destructive tests against the working database.
POSTGRES_PASSWORD=hryukers-local-db
WEB_PORT=5181
POSTGRES_PORT=55433
VALKEY_PORT=56380
ALLOWED_ORIGINS=http://localhost:5181,http://127.0.0.1:5181
SEED_WORKSPACE_DATA=true
SEED_DEMO_ACCOUNTS=true
DEPLOYMENT_MODE=local
